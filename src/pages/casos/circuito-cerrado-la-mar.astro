---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dar2.cl/' },
  { name: 'Casos', url: 'https://dar2.cl/casos/' },
  { name: 'Circuito Cerrado Multicámara · La Mar Cebichería', url: 'https://dar2.cl/casos/circuito-cerrado-la-mar/' },
];

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Circuito Cerrado Multicámara para Eventos: Caso La Mar",
  "description": "Aprende a ejecutar una transmisión en circuito cerrado multicámara de baja latencia para eventos corporativos y gastronómicos. Caso La Mar por DAR2.",
  "image": {
    "@type": "ImageObject",
    "url": "https://dar2.cl/images/casos/circuito-cerrado-la-mar/ambiente-salones.webp",
    "width": 1600,
    "height": 901
  },
  "datePublished": "2026-08-22",
  "dateModified": "2026-08-25",
  "author": {
    "@type": "Person",
    "@id": "https://dar2.cl/#person",
    "name": "Carlos Rios Guevara"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://dar2.cl/#organization",
    "name": "DAR2 Servicios Audiovisuales",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dar2.cl/images/galeria/dar2_logo_firma.png",
      "width": 400,
      "height": 118
    }
  },
  "mainEntityOfPage": "https://dar2.cl/casos/circuito-cerrado-la-mar/",
  "about": { "@id": "https://dar2.cl/casos/circuito-cerrado-la-mar/#event" },
  "inLanguage": "es-CL",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".case-header", ".case-section"]
  }
};

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": "https://dar2.cl/casos/circuito-cerrado-la-mar/#event",
  "name": "Aniversario 18 Años de La Mar Cebichería — El Mar que Nos Une",
  "description": "Cumbre culinaria por los 18 años de La Mar Cebichería Santiago, encabezada por Gastón Acurio junto a los chefs Carlos Labrín, Anthony Vásquez y Diego Oka, con cobertura multicámara en vivo de DAR2.",
  "startDate": "2026-08-20",
  "endDate": "2026-08-21",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "La Mar Cebichería Santiago",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Av. Nueva Costanera 4076",
      "addressLocality": "Vitacura",
      "addressRegion": "Región Metropolitana",
      "addressCountry": "CL"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "La Mar Cebichería",
    "url": "https://www.instagram.com/lamarcebicheriasantiago"
  },
  "performer": [
    { "@type": "Person", "name": "Gastón Acurio" },
    { "@type": "Person", "name": "Carlos Labrín" },
    { "@type": "Person", "name": "Anthony Vásquez" },
    { "@type": "Person", "name": "Diego Oka" }
  ],
  "image": "https://dar2.cl/images/casos/circuito-cerrado-la-mar/ambiente-salones.webp",
  "inLanguage": "es-CL"
};
---

<Base
  title="Circuito Cerrado Multicámara para Eventos: Caso La Mar"
  description="Aprende a ejecutar una transmisión en circuito cerrado multicámara de baja latencia para eventos corporativos y gastronómicos. Caso La Mar por DAR2."
  breadcrumbs={breadcrumbs}
  preloadImage="/images/casos/circuito-cerrado-la-mar/ambiente-salones.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  </Fragment>

  <article class="case-wrap">

    <!-- Hero -->
    <header class="case-header">
      <p class="case-eyebrow">Caso · Gastronomía · 2026</p>
      <h1 class="case-h1">
        Circuito Cerrado Multicámara para Eventos:
        <em class="hl">Caso La Mar.</em>
      </h1>
      <p class="case-lead">
        El servicio de circuito cerrado multicámara para eventos corporativos proyecta detalles en tiempo real con latencia cero hacia pantallas gigantes. La combinación de switcher digital, ópticas de alta luminosidad y transmisión SDI/NDI asegura una experiencia inmersiva para los asistentes en Santiago.
      </p>
    </header>

    <!-- Ficha técnica -->
    <dl class="case-overview">
      <div>
        <dt class="overview-label">Cliente</dt>
        <dd class="overview-value">La Mar Cebichería</dd>
      </div>
      <div>
        <dt class="overview-label">Año</dt>
        <dd class="overview-value">2026</dd>
      </div>
      <div>
        <dt class="overview-label">Servicio</dt>
        <dd class="overview-value">Circuito Cerrado (CCTV) Multicámara</dd>
      </div>
      <div>
        <dt class="overview-label">Sector</dt>
        <dd class="overview-value">Gastronomía</dd>
      </div>
    </dl>

    <!-- Imagen hero -->
    <div class="case-hero-image">
      <Picture
        src="/images/casos/circuito-cerrado-la-mar/ambiente-salones.jpg"
        alt="Circuito cerrado multicámara para eventos — ambiente del evento de La Mar Cebichería con pantallas en vivo"
        class="w-full h-full object-cover"
        width="1600"
        height="901"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>

    <!-- El reto técnico -->
    <section class="case-section">
      <h2>El reto técnico de proyectar eventos en vivo sin latencia ni pérdida de calidad.</h2>
      <p>
        Organizar un evento corporativo, activación de marca o máster class gastronómica con gran afluencia de público en Chile plantea un desafío recurrente para las agencias de eventos y directores de marketing:
      </p>
      <ul>
        <li><strong>Pérdida de visibilidad:</strong> Los asistentes ubicados en las filas traseras se pierden los detalles finos de la presentación o preparación.</li>
        <li><strong>Retardo de señal (latencia):</strong> Un desfase entre el audio en vivo y la imagen en pantalla destruye la experiencia del espectador.</li>
        <li><strong>Iluminación variable:</strong> Los cambios de luz natural o ambiental en restaurantes y salones dificultan la captura clara de los detalles.</li>
      </ul>
    </section>

    <!-- Caso de éxito -->
    <section class="case-section">
      <h2>Caso de Éxito: Circuito Cerrado Multicámara en Cebichería La Mar.</h2>
      <p>
        Cebichería La Mar celebró un evento exclusivo de alta gastronomía en Santiago que requería mostrar en vivo y en detalle el trabajo de precisión de sus chefs ante una audiencia presencial exigente.
      </p>
      <p>
        DAR2 diseñó e implementó un sistema de <strong>circuito cerrado multicámara (CCTV)</strong> de estándar broadcast en el recinto, conectando la acción en la cocina directo a pantallas estratégicas:
      </p>
      <div class="case-duo">
        <div class="case-hero-image case-image-inline">
          <Picture
            src="/images/casos/circuito-cerrado-la-mar/camara-ptz-estacion-1.jpg"
            alt="Cámara robótica PTZ instalada sobre una estación del evento de La Mar"
            class="w-full h-full object-cover"
            width="1600"
            height="901"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="case-hero-image case-image-inline">
          <Picture
            src="/images/casos/circuito-cerrado-la-mar/camarografos-inalambricos.jpg"
            alt="Camarógrafos inalámbricos cubriendo el salón del evento de La Mar"
            class="w-full h-full object-cover"
            width="1600"
            height="901"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="case-flow">
        <div class="case-flow-card case-flow--desafio">
          <span class="case-flow-label">Desafío del evento</span>
          <p>Proyectar cortes y montajes finos a más de 100 invitados presenciales.</p>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--solucion">
          <span class="case-flow-label">Despliegue técnico</span>
          <ul>
            <li>Configuración multicámara SDI con ópticas fijas luminosas</li>
            <li>Cámara cenital fija sobre la estación de preparación</li>
            <li>Switcher de video digital para mezcla en vivo de baja latencia</li>
          </ul>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--resultado">
          <span class="case-flow-label">Resultado en vivo</span>
          <ul>
            <li>Transmisión fluida a pantallas LED sin desfase de audio/imagen</li>
            <li>Máxima inmersión del público y visibilidad total del showcooking</li>
          </ul>
        </div>
      </div>
      <figure class="case-figure case-figure--square">
        <Picture
          src="/images/casos/circuito-cerrado-la-mar/gaston-acurio.jpg"
          alt="Gastón Acurio durante el evento de La Mar con cobertura multicámara en vivo"
          class="w-full h-full object-cover"
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <!-- Factores clave -->
    <section class="case-section">
      <h2>Factores clave para un circuito cerrado corporativo impecable.</h2>
      <p>
        Garantizar la transmisión fluida en un evento en vivo requiere coordinar aspectos técnicos indispensables antes y durante el montaje:
      </p>
      <ol>
        <li><strong>Cableado SDI y Red NDI:</strong> Utilizar conexiones físicas SDI para evitar las caídas de señal y la latencia propia de los sistemas inalámbricos convencionales.</li>
        <li><strong>Cámaras Cenitales Fijas:</strong> Instalar encuadres cenitales sobre mesas de trabajo o escenarios para mostrar vistas superiores imposibles de ver a simple vista.</li>
        <li><strong>Dirección y Mezcla en Vivo:</strong> Contar con un realizador audiovisual en el switcher que alterne entre planos generales y detalles según el ritmo de la presentación.</li>
        <li><strong>Iluminación Focalizada:</strong> Incorporar luces LED de temperatura controlada para resaltar texturas y colores sin incomodar al expositor.</li>
      </ol>
    </section>

    <!-- Beneficios -->
    <section class="case-section">
      <h2>Beneficios del circuito cerrado para marcas y producciones corporativas.</h2>
      <p>
        Integrar un sistema de pantalla gigante y circuito cerrado transforma la percepción del evento B2B:
      </p>
      <ul>
        <li><strong>Involucramiento del público:</strong> Cada asistente, sin importar su ubicación en el salón, tiene una vista privilegiada en HD/4K.</li>
        <li><strong>Registro de contenido posterior:</strong> La señal mezclada en vivo queda grabada en alta calidad para generar resúmenes, reels y material de prensa.</li>
        <li><strong>Flexibilidad de integración:</strong> Permite enviar la señal en paralelo a plataformas de streaming como YouTube, LinkedIn o sistemas de videoconferencia.</li>
      </ul>
    </section>

    <!-- Galería -->
    <section class="case-section case-gallery">
      <h2>Galería del evento.</h2>
      <p>
        El showcooking transmitido en vivo a las pantallas y las estaciones gastronómicas en acción durante el evento.
      </p>
      <div class="case-gallery-grid">
        <div class="case-gallery-item">
          <Picture
            src="/images/casos/circuito-cerrado-la-mar/estacion-brasas.jpg"
            alt="Estación de brasas de La Mar transmitida en vivo a las pantallas del evento"
            class="w-full h-full object-cover"
            width="1600"
            height="901"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="case-gallery-item">
          <Picture
            src="/images/casos/circuito-cerrado-la-mar/estacion-postres.jpg"
            alt="Estación de postres de La Mar con cobertura multicámara en vivo"
            class="w-full h-full object-cover"
            width="1600"
            height="901"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="case-section case-cta-final">
      <h2>¿Planeas un evento corporativo o activación de marca en Chile?</h2>
      <p>
        En DAR2 entregamos cobertura multicámara y circuito cerrado de baja latencia para eventos corporativos, congresos y lanzamientos de marca en Santiago.
      </p>
      <div class="case-cta">
        <a href="/contacto/" class="case-cta-btn">
          Cotizar Circuito Cerrado Multicámara →
        </a>
        <a href="/servicios/streaming/" class="case-cta-link">
          Conocer streaming corporativo →
        </a>
      </div>
    </section>

  </article>
</Base>

<style>
  .case-wrap { max-width: 880px; margin: 0 auto; padding: 64px 24px 96px; }

  .case-header { margin-bottom: 40px; }
  .case-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #666; margin-bottom: 24px;
  }
  .case-h1 {
    font-size: clamp(36px, 5vw, 60px); font-weight: 900; line-height: 1.05; letter-spacing: -1.5px;
    margin: 0 0 24px;
  }
  .case-lead { font-size: 20px; line-height: 1.5; color: #333; margin: 0; max-width: 720px; }

  .case-overview {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;
    border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;
    padding: 24px 0; margin: 48px 0;
  }
  @media (min-width: 640px) { .case-overview { grid-template-columns: repeat(4, 1fr); } }
  .overview-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #888; margin: 0 0 6px;
  }
  .overview-value { font-size: 16px; font-weight: 700; color: #1a1a1a; margin: 0; line-height: 1.4; }

  .case-hero-image {
    aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #eaeaea;
    margin-bottom: 56px;
  }
  .case-image-inline { margin-bottom: 48px; }

  .case-figure { margin: 0; }
  .case-figure--square :global(picture) {
    display: block; border-radius: 16px; overflow: hidden; background: #eaeaea;
    max-width: 420px; aspect-ratio: 1 / 1; margin: 0 auto;
  }
  .case-figure--square :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .case-duo {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    margin: 0 0 48px;
  }
  .case-duo .case-hero-image { margin-bottom: 0; }

  .case-gallery { margin-bottom: 64px; }
  .case-gallery-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 12px; margin-top: 28px;
  }
  @media (min-width: 640px) { .case-gallery-grid { gap: 16px; } }
  .case-gallery-item { border-radius: 12px; overflow: hidden; background: #eaeaea; }
  .case-gallery-item :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .case-section { margin-bottom: 48px; }
  .case-section h2 {
    font-size: clamp(28px, 3.5vw, 36px); font-weight: 900; letter-spacing: -0.5px;
    line-height: 1.1; margin: 0 0 20px;
  }
  .case-section h3 {
    font-size: 22px; font-weight: 800; letter-spacing: -0.3px; margin: 0 0 16px;
  }
  .case-section p {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 18px;
  }
  .case-section p strong {
    color: #1a1a1a; font-weight: 700;
  }

  /* Listas (bullets y numeradas) dentro de secciones */
  .case-section ul, .case-section ol {
    margin: 0 0 18px; padding-left: 22px;
  }
  .case-section li {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 10px;
  }
  .case-section li strong {
    color: #1a1a1a; font-weight: 700;
  }

  /* Tarjetas en cascada: Desafio -> Despliegue -> Resultado */
  .case-flow { margin: 24px 0 8px; }
  .case-flow-card {
    border-radius: 14px; padding: 24px;
    background: #fafafa; border: 1px solid #e5e5e5; margin-bottom: 0;
  }
  .case-flow--desafio { border-left: 4px solid #1a1a1a; }
  .case-flow--solucion { border-left: 4px solid #FF4500; }
  .case-flow--resultado { border-left: 4px solid #E63E00; }
  .case-flow-label {
    display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: #666; margin-bottom: 10px;
  }
  .case-flow-card p { font-size: 16px; line-height: 1.6; color: #333; margin: 0; }
  .case-flow-card ul { margin: 0; padding-left: 18px; }
  .case-flow-card li { font-size: 15px; line-height: 1.6; color: #333; margin-bottom: 6px; }
  .case-flow-card li:last-child { margin-bottom: 0; }
  .case-flow-arrow {
    display: block; text-align: center; color: #999; font-size: 20px;
    line-height: 1; margin: 14px 0;
  }

  .case-cta-final {
    background: #1a1a1a; color: #fff; border-radius: 16px; padding: 48px;
    margin-top: 80px;
  }
  .case-cta-final h2 { color: #fff; margin: 0 0 16px; }
  .case-cta-final p { color: #ccc; }
  .case-cta { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .case-cta-btn {
    display: inline-flex; align-items: center; background: #FF4500; color: #fff;
    font-size: 15px; font-weight: 700; padding: 14px 24px; border-radius: 12px;
    text-decoration: none; transition: background 0.2s ease;
  }
  .case-cta-btn:hover { background: #e03d00; }
  .case-cta-link {
    color: #ccc; font-size: 14px; font-weight: 600; text-decoration: none;
    transition: color 0.2s ease;
  }
  .case-cta-link:hover { color: #fff; }
</style>
