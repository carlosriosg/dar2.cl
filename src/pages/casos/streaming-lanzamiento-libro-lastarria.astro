---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dar2.cl/' },
  { name: 'Casos', url: 'https://dar2.cl/casos/' },
  { name: 'Streaming Lanzamiento de Libro · El Espíritu de la Radio', url: 'https://dar2.cl/casos/streaming-lanzamiento-libro-lastarria/' },
];

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Streaming Lanzamiento de Libro: Caso El Espíritu de la Radio",
  "description": "Aprende cómo realizar un streaming multicámara para lanzamientos de libros en Santiago con cámaras PTZ, vMix y módem 5G. Caso por DAR2.",
  "image": {
    "@type": "ImageObject",
    "url": "https://dar2.cl/images/casos/streaming-lanzamiento-libro-lastarria/evento-publico.jpg",
    "width": 2252,
    "height": 1307
  },
  "datePublished": "2026-08-25",
  "dateModified": "2026-08-25",
  "author": {
    "@type": "Person",
    "@id": "https://dar2.cl/#person",
    "name": "Carlos Rios Guevara"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://dar2.cl/#organization",
    "name": "DAR2 Servicios Audiovisuales",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dar2.cl/images/galeria/dar2_logo_firma.png",
      "width": 400,
      "height": 118
    }
  },
  "mainEntityOfPage": "https://dar2.cl/casos/streaming-lanzamiento-libro-lastarria/",
  "about": {
    "@type": "Organization",
    "name": "Santiago-Ander Editorial",
    "url": "https://santiagoander.cl"
  },
  "inLanguage": "es-CL",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".case-header", ".case-section"]
  }
};
---

<Base
  title="Streaming Lanzamiento de Libro: Caso El Espíritu de la Radio"
  description="Aprende cómo realizar un streaming multicámara para lanzamientos de libros en Santiago con cámaras PTZ, vMix y módem 5G. Caso por DAR2."
  breadcrumbs={breadcrumbs}
  preloadImage="/images/casos/streaming-lanzamiento-libro-lastarria/evento-publico.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseSchema)} />
  </Fragment>

  <article class="case-wrap">

    <!-- Hero -->
    <header class="case-header">
      <p class="case-eyebrow">Caso · Cultural · 2024</p>
      <h1 class="case-h1">
        Streaming Lanzamiento de Libro:
        <em class="hl">El Espíritu de la Radio.</em>
      </h1>
      <p class="case-lead">
        El streaming para lanzamientos de libros en Santiago requiere cámaras PTZ robóticas, switchers digitales y conectividad 5G. Esta configuración permite transmitir presentaciones culturales en vivo a miles de personas con calidad broadcast sin invadir la visión del público presencial.
      </p>
    </header>

    <!-- Ficha técnica -->
    <dl class="case-overview">
      <div>
        <dt class="overview-label">Cliente</dt>
        <dd class="overview-value">Santiago-Ander Editorial / El Ágora</dd>
      </div>
      <div>
        <dt class="overview-label">Año</dt>
        <dd class="overview-value">2024</dd>
      </div>
      <div>
        <dt class="overview-label">Servicio</dt>
        <dd class="overview-value">Streaming Corporativo</dd>
      </div>
      <div>
        <dt class="overview-label">Sector</dt>
        <dd class="overview-value">Cultural</dd>
      </div>
    </dl>

    <!-- Imagen hero -->
    <div class="case-hero-image">
      <Picture
        src="/images/casos/streaming-lanzamiento-libro-lastarria/evento-publico.jpg"
        alt="Streaming en vivo del lanzamiento del libro El Espíritu de la Radio en Fuente Lastarria — DAR2"
        class="w-full h-full object-cover"
        width="2252"
        height="1307"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>

    <!-- Retos técnicos -->
    <section class="case-section">
      <h2>Retos técnicos de transmitir eventos culturales en recintos reducidos.</h2>
      <p>
        Proyectar la presentación de una obra literaria o evento cultural vía streaming desde ubicaciones con alta concurrencia en Santiago (como Barrio Lastarria o Bellas Artes) plantea desafíos operativos específicos:
      </p>
      <ul>
        <li><strong>Espacio físico acotado:</strong> Los salones de restaurantes y centros culturales dificultan la instalación de trípodes tradicionales y camarógrafos en terreno.</li>
        <li><strong>Saturación de red móvil:</strong> Las conexiones Wi-Fi o móviles convencionales no garantizan el bitrate constante necesario para una transmisión HD fluida.</li>
        <li><strong>Acústica variable:</strong> El ruido ambiente de espacios gastronómicos exige microfonía inalámbrica profesional conectada a un sistema de amplificación local dedicado.</li>
      </ul>
    </section>

    <!-- Caso de éxito -->
    <section class="case-section">
      <h2>Caso de Éxito: Streaming del libro "El espíritu de la radio" en Fuente Lastarria.</h2>
      <p>
        El 20 de noviembre de 2024 se realizó en Fuente Lastarria (Merced 333, Santiago) el relanzamiento del libro <em>"El espíritu de la radio"</em>, obra escrita por los autores <a href="https://www.instagram.com/paozuluz" target="_blank" rel="noopener noreferrer">Paola Zúñiga Marro</a> y <a href="https://www.instagram.com/rodrigocabrillana" target="_blank" rel="noopener noreferrer">Rodrigo Cabrillana</a>.
      </p>
      <p>
        El evento fue organizado por <a href="https://santiagoander.cl/" target="_blank" rel="noopener noreferrer">Santiago-Ander Editorial</a> y <a href="https://www.elagora.net/" target="_blank" rel="noopener noreferrer">El Ágora</a>, contando con un panel integrado por destacados invitados culturales:
      </p>
      <div class="case-hero-image case-image-inline">
        <Picture
          src="/images/casos/streaming-lanzamiento-libro-lastarria/panel-artistas.jpg"
          alt="Panel de invitados en el streaming del lanzamiento de El Espíritu de la Radio — DAR2"
          class="w-full h-full object-cover"
          width="4000"
          height="2252"
          loading="lazy"
          decoding="async"
        />
      </div>
      <ul>
        <li><a href="https://www.instagram.com/joevasconcellos" target="_blank" rel="noopener noreferrer">Joe Vasconcellos</a> — Músico y compositor</li>
        <li><a href="https://www.instagram.com/patriciadiazinostroza" target="_blank" rel="noopener noreferrer">Patricia Díaz Inostroza</a> — Periodista e investigadora</li>
        <li><a href="https://www.instagram.com/rolaverde" target="_blank" rel="noopener noreferrer">Rola Verde</a> — Locutor y comunicador</li>
        <li><a href="https://www.instagram.com/juanramonmagana" target="_blank" rel="noopener noreferrer">Juan Ramón Magaña</a> — Comunicador radial</li>
      </ul>
      <p>
        Para transmitir esta presentación a miles de espectadores en vivo, DAR2 desplegó un setup multicámara robótico e invisible para la audiencia presencial:
      </p>
      <div class="case-flow">
        <div class="case-flow-card case-flow--desafio">
          <span class="case-flow-label">Desafío del evento</span>
          <p>Transmitir evento masivo desde Fuente Lastarria con espacio acotado.</p>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--solucion">
          <span class="case-flow-label">Despliegue técnico</span>
          <ul>
            <li>3x cámaras PTZ robóticas con control IP dedicado</li>
            <li>Switcher y titulación en vivo con vMix en resolución HD</li>
            <li>Conexión redundante vía módem 5G bonding de alta velocidad</li>
            <li>Microfonía inalámbrica + amplificación para el salón presencial</li>
          </ul>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--resultado">
          <span class="case-flow-label">Resultado en vivo</span>
          <ul>
            <li>Transmisión estable vista por miles de personas sin interrupciones</li>
            <li>Cobertura visual dinámica sin obstruir la vista del público</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Setup técnico -->
    <section class="case-section">
      <h2>Configuración del setup técnico para eventos culturales y B2B.</h2>
      <p>
        Para garantizar un estándar de transmisión broadcast en recintos gastronómicos, implementamos una arquitectura técnica probada:
      </p>
      <h3>1. Cámaras PTZ Robóticas y Control IP</h3>
      <ul>
        <li>Instalación de 3 cámaras PTZ de alta sensibilidad en puntos estratégicos del recinto.</li>
        <li>Operación remota desde un controlador IP centralizado, evitando camarógrafos frente a la mesa del panel.</li>
        <li>Programación de presets para alternar instantáneamente entre planos generales, encuadres cerrados de los autores y preguntas del público.</li>
      </ul>
      <h3>2. Conectividad 5G Dedicada y Switcher con vMix</h3>
      <ul>
        <li>Enrutamiento de señal hacia el software vMix para realizar mezcla en vivo, inserción de zócalos con nombres y gráfica de marca.</li>
        <li>Emisión mediante módem 5G de grado industrial para prevenir caídas por saturación de celdas móviles en zonas de alto tráfico en Santiago.</li>
      </ul>
      <h3>3. Audio Inalámbrico y Sistema Híbrido</h3>
      <ul>
        <li>Microfonía inalámbrica de alta directividad para capturar la voz limpia de cada expositor.</li>
        <li>Salida dividida de audio: mezcla limpia para el flujo de streaming en vivo y alimentación paralela hacia la amplificación del local para los asistentes presenciales.</li>
      </ul>
      <div class="case-duo">
        <div class="case-hero-image case-image-inline">
          <Picture
            src="/images/casos/streaming-lanzamiento-libro-lastarria/setup-ptz.jpg"
            alt="Setup de cámaras PTZ y switcher vMix para streaming en vivo — DAR2"
            class="w-full h-full object-cover"
            width="4000"
            height="2252"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="case-hero-image case-image-inline">
          <Picture
            src="/images/casos/streaming-lanzamiento-libro-lastarria/camara-ptz.jpg"
            alt="Cámara PTZ robótica instalada para el streaming del evento cultural — DAR2"
            class="w-full h-full object-cover"
            width="4000"
            height="2252"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- Ventajas PTZ -->
    <section class="case-section">
      <h2>Ventajas de usar cámaras PTZ en transmisiones de eventos.</h2>
      <p>
        Integrar robótica en la cobertura audiovisual de lanzamientos y presentaciones ofrece beneficios clave para la producción:
      </p>
      <ul>
        <li><strong>Invisibilidad operativa:</strong> Al no requerir operadores detrás de cada lente, el público presencial disfruta de una vista despejada.</li>
        <li><strong>Optimización de recursos:</strong> Un solo operador puede dirigir múltiples ángulos de cámara mediante un joystick IP.</li>
        <li><strong>Calidad de imagen uniforme:</strong> Ajustes coordinados de color y exposición en todas las cámaras desde la mesa de control.</li>
      </ul>
    </section>

    <!-- CTA -->
    <section class="case-section case-cta-final">
      <h2>¿Planeas el lanzamiento de un libro o evento cultural en Santiago?</h2>
      <p>
        En DAR2 entregamos servicios de streaming corporativo, multicámara PTZ y conectividad 5G para eventos, lanzamientos y conferencias en todo Chile.
      </p>
      <div class="case-cta">
        <a href="/contacto/" class="case-cta-btn">
          Cotizar servicio de Streaming →
        </a>
        <a href="/servicios/streaming/" class="case-cta-link">
          Conocer Streaming Corporativo →
        </a>
      </div>
    </section>

  </article>
</Base>

<style>
  .case-wrap { max-width: 880px; margin: 0 auto; padding: 64px 24px 96px; }

  .case-header { margin-bottom: 40px; }
  .case-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #666; margin-bottom: 24px;
  }
  .case-h1 {
    font-size: clamp(36px, 5vw, 60px); font-weight: 900; line-height: 1.05; letter-spacing: -1.5px;
    margin: 0 0 24px;
  }
  .case-lead { font-size: 20px; line-height: 1.5; color: #333; margin: 0; max-width: 720px; }

  .case-overview {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;
    border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;
    padding: 24px 0; margin: 48px 0;
  }
  @media (min-width: 640px) { .case-overview { grid-template-columns: repeat(4, 1fr); } }
  .overview-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #888; margin: 0 0 6px;
  }
  .overview-value { font-size: 16px; font-weight: 700; color: #1a1a1a; margin: 0; line-height: 1.4; }

  .case-hero-image {
    aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #eaeaea;
    margin-bottom: 56px;
  }
  .case-image-inline { margin-bottom: 48px; }

  .case-duo {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    margin: 0 0 48px;
  }
  .case-duo .case-hero-image { margin-bottom: 0; }

  .case-section { margin-bottom: 48px; }
  .case-section h2 {
    font-size: clamp(28px, 3.5vw, 36px); font-weight: 900; letter-spacing: -0.5px;
    line-height: 1.1; margin: 0 0 20px;
  }
  .case-section h3 {
    font-size: 22px; font-weight: 800; letter-spacing: -0.3px; margin: 32px 0 16px;
  }
  .case-section p {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 18px;
  }
  .case-section p strong {
    color: #1a1a1a; font-weight: 700;
  }
  .case-section a {
    color: #E63E00; font-weight: 600; text-decoration: underline; text-underline-offset: 2px;
  }
  .case-section a:hover { color: #FF4500; }

  /* Listas (bullets y numeradas) dentro de secciones */
  .case-section ul, .case-section ol {
    margin: 0 0 18px; padding-left: 22px;
  }
  .case-section li {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 10px;
  }
  .case-section li strong {
    color: #1a1a1a; font-weight: 700;
  }

  /* Tarjetas en cascada: Desafio -> Despliegue -> Resultado */
  .case-flow { margin: 24px 0 8px; }
  .case-flow-card {
    border-radius: 14px; padding: 24px;
    background: #fafafa; border: 1px solid #e5e5e5; margin-bottom: 0;
  }
  .case-flow--desafio { border-left: 4px solid #1a1a1a; }
  .case-flow--solucion { border-left: 4px solid #FF4500; }
  .case-flow--resultado { border-left: 4px solid #E63E00; }
  .case-flow-label {
    display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: #666; margin-bottom: 10px;
  }
  .case-flow-card p { font-size: 16px; line-height: 1.6; color: #333; margin: 0; }
  .case-flow-card ul { margin: 0; padding-left: 18px; }
  .case-flow-card li { font-size: 15px; line-height: 1.6; color: #333; margin-bottom: 6px; }
  .case-flow-card li:last-child { margin-bottom: 0; }
  .case-flow-arrow {
    display: block; text-align: center; color: #999; font-size: 20px;
    line-height: 1; margin: 14px 0;
  }

  .case-cta-final {
    background: #1a1a1a; color: #fff; border-radius: 16px; padding: 48px;
    margin-top: 80px;
  }
  .case-cta-final h2 { color: #fff; margin: 0 0 16px; }
  .case-cta-final p { color: #ccc; }
  .case-cta { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .case-cta-btn {
    display: inline-flex; align-items: center; background: #FF4500; color: #fff;
    font-size: 15px; font-weight: 700; padding: 14px 24px; border-radius: 12px;
    text-decoration: none; transition: background 0.2s ease;
  }
  .case-cta-btn:hover { background: #e03d00; }
  .case-cta-link {
    color: #ccc; font-size: 14px; font-weight: 600; text-decoration: none;
    transition: color 0.2s ease;
  }
  .case-cta-link:hover { color: #fff; }
</style>
