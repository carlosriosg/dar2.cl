---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dar2.cl/' },
  { name: 'Casos', url: 'https://dar2.cl/casos/' },
  { name: 'Producción de Video Podcast · Transelec', url: 'https://dar2.cl/casos/podcast-transelec-innovacion-china/' },
];

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Producción de Video Podcast Corporativo: Caso Transelec",
  "description": "Descubre cómo producir un video podcast corporativo estratégico para comunicación interna e innovación. Caso Transelec por DAR2.",
  "image": {
    "@type": "ImageObject",
    "url": "https://dar2.cl/images/podcast/set-general.jpg",
    "width": 1200,
    "height": 676
  },
  "datePublished": "2026-06-15",
  "dateModified": "2026-08-25",
  "author": {
    "@type": "Person",
    "@id": "https://dar2.cl/#person",
    "name": "Carlos Rios Guevara"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://dar2.cl/#organization",
    "name": "DAR2 Servicios Audiovisuales",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dar2.cl/images/galeria/dar2_logo_firma.png",
      "width": 400,
      "height": 118
    }
  },
  "mainEntityOfPage": "https://dar2.cl/casos/podcast-transelec-innovacion-china/",
  "about": {
    "@type": "Organization",
    "name": "Transelec",
    "url": "https://www.transelec.cl"
  },
  "inLanguage": "es-CL",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".case-header", ".case-section"]
  }
};
---

<Base
  title="Producción de Video Podcast Corporativo: Caso Transelec"
  description="Descubre cómo producir un video podcast corporativo estratégico para comunicación interna e innovación. Caso Transelec por DAR2."
  breadcrumbs={breadcrumbs}
  preloadImage="/images/podcast/set-general.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseSchema)} />
  </Fragment>

  <article class="case-wrap">

    <!-- Hero -->
    <header class="case-header">
      <p class="case-eyebrow">Caso · Energía · 2026</p>
      <h1 class="case-h1">
        Producción de Video Podcast Corporativo:
        <em class="hl">Caso Transelec.</em>
      </h1>
      <p class="case-lead">
        El video podcast corporativo es una herramienta de comunicación interna estratégica que transforma contenidos complejos e hitos de innovación en conversaciones cercanas y dinámicas. Mediante una producción multicámara profesional en estudio o locación, las empresas logran conectar emocionalmente con sus colaboradores y fortalecer su cultura organizacional.
      </p>
    </header>

    <!-- Ficha técnica -->
    <dl class="case-overview">
      <div>
        <dt class="overview-label">Cliente</dt>
        <dd class="overview-value">Transelec (Innovación y Ventures)</dd>
      </div>
      <div>
        <dt class="overview-label">Servicio</dt>
        <dd class="overview-value">Video Podcast Corporativo</dd>
      </div>
      <div>
        <dt class="overview-label">Audiencia</dt>
        <dd class="overview-value">+500 colaboradores</dd>
      </div>
      <div>
        <dt class="overview-label">Formato</dt>
        <dd class="overview-value">Serie de episodios + cápsulas</dd>
      </div>
    </dl>

    <!-- Imagen hero -->
    <div class="case-hero-image">
      <Picture
        src="/images/podcast/set-general.jpg"
        alt="Set de video podcast corporativo producido por DAR2 para Transelec"
        class="w-full h-full object-cover"
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>

    <!-- Por qué video podcast -->
    <section class="case-section">
      <h2>Por qué el formato video podcast está revolucionando la comunicación interna B2B.</h2>
      <p>
        Transmitir reportes de innovación, viajes de prospección tecnológica o cambios estratégicos a los equipos de una gran compañía en Chile suele enfrentar barreras de atención:
      </p>
      <ul>
        <li><strong>Bajo consumo de boletines escritos:</strong> Los correos masivos y PDFs institucionales registran tasas de lectura decrecientes.</li>
        <li><strong>Falta de cercanía en el liderazgo:</strong> Las presentaciones ejecutivas rígidas no logran transmitir la visión ni la experiencia humana detrás de los proyectos.</li>
        <li><strong>Necesidad de formatos consumibles on-demand:</strong> Los colaboradores buscan formatos ágiles que puedan escuchar o ver en sus tiempos de traslado o pausa laboral.</li>
      </ul>
    </section>

    <!-- Caso de éxito -->
    <section class="case-section">
      <h2>Caso de Éxito: Video Podcast de Innovación para Transelec.</h2>
      <p>
        Transelec, la empresa líder en transmisión eléctrica en Chile, realizó una misión de prospección tecnológica e innovación en China. El desafío consistía en bajar los aprendizajes clave de ese viaje a toda la organización sin recurrir a una memoria técnica tradicional.
      </p>
      <p>
        Para resolverlo, DAR2 diseñó un formato de <strong>video podcast corporativo</strong> de varios episodios, transformando el reporte de innovación en una conversación fluida entre los líderes que viajaron:
      </p>
      <div class="case-duo">
        <div class="case-hero-image case-image-inline">
          <Picture
            src="/images/podcast/los-3-conversando.jpg"
            alt="Líderes de Transelec conversando en el video podcast corporativo producido por DAR2"
            class="w-full h-full object-cover"
            width="1200"
            height="676"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="case-hero-image case-image-inline">
          <Picture
            src="/images/podcast/los-3-saludando.jpg"
            alt="Los líderes de Transelec en el set del video podcast corporativo de DAR2"
            class="w-full h-full object-cover"
            width="1200"
            height="676"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="case-flow">
        <div class="case-flow-card case-flow--desafio">
          <span class="case-flow-label">Desafío comunicacional</span>
          <p>Bajar aprendizajes de innovación en China a +500 colaboradores.</p>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--solucion">
          <span class="case-flow-label">Solución audiovisual</span>
          <ul>
            <li>Montaje de estudio podcast en oficinas corporativas en Santiago</li>
            <li>Configuración multicámara 4K con óptica fija y switcher digital</li>
            <li>Microfonía Shure SM7B para calidad de audio broadcast</li>
          </ul>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--resultado">
          <span class="case-flow-label">Entregables y distribución</span>
          <ul>
            <li>Serie de episodios de 15 minutos para la intranet corporativa</li>
            <li>Micro-clips horizontales y verticales para canales internos</li>
            <li>Formato modular de fácil consumo para toda la compañía</li>
          </ul>
        </div>
      </div>
      <div class="case-hero-image case-image-inline">
        <Picture
          src="/images/podcast/plano-general-estudio.jpg"
          alt="Plano general del estudio de video podcast corporativo montado por DAR2 para Transelec"
          class="w-full h-full object-cover"
          width="1200"
          height="676"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <!-- Factores clave -->
    <section class="case-section">
      <h2>Factores clave para la producción de un video podcast corporativo de alto impacto.</h2>
      <p>
        Para asegurar que una producción de video podcast cumpla con el estándar que exige una corporación B2B, es necesario coordinar aspectos técnicos fundamentales:
      </p>
      <ol>
        <li><strong>Iluminación y Set Branding:</strong> Diseñar una puesta en escena cálida que integre la identidad visual de la marca sin saturar el encuadre.</li>
        <li><strong>Audio de Nivel Broadcast:</strong> Utilizar micrófonos dinámicos de estudio (como Shure SM7B) y procesamiento en tiempo real para un sonido limpio y envolvente.</li>
        <li><strong>Grabación Multicámara NDI/SDI:</strong> Operar con múltiples ángulos de cámara sincronizados para permitir un corte dinámico durante la conversación en postproducción.</li>
        <li><strong>Estrategia de Contenido Modular:</strong> Extraer cápsulas o "reels" de los momentos clave para potenciar el alcance en redes sociales corporativas como LinkedIn.</li>
      </ol>
    </section>

    <!-- Ventajas estratégicas -->
    <section class="case-section">
      <h2>Ventajas estratégicas del video podcast para las empresas en Chile.</h2>
      <p>
        Adoptar este formato audiovisual entrega beneficios tangibles para las áreas de Gestión de Personas, Innovación y Marketing Corporativo:
      </p>
      <ul>
        <li><strong>Mayor Retención del Mensaje:</strong> La combinación de lenguaje corporal, tono de voz espontáneo y recursos visuales aumenta el engagement.</li>
        <li><strong>Escalabilidad de la Información:</strong> El material queda alojado en la intranet o plataformas B2B para consulta continua de nuevos colaboradores.</li>
        <li><strong>Humanización de los Líderes:</strong> Muestra la faceta humana y cercana de los ejecutivos al compartir aprendizajes y desafíos reales.</li>
      </ul>
    </section>

    <!-- CTA -->
    <section class="case-section case-cta-final">
      <h2>¿Quieres implementar un video podcast para tu empresa?</h2>
      <p>
        En DAR2 diseñamos y producimos video podcasts corporativos en nuestro estudio profesional o en las dependencias de tu empresa en Santiago y todo Chile.
      </p>
      <div class="case-cta">
        <a href="/contacto/" class="case-cta-btn">
          Cotizar producción de Video Podcast →
        </a>
        <a href="/servicios/podcast/" class="case-cta-link">
          O ver el servicio Video Podcast →
        </a>
      </div>
    </section>

  </article>
</Base>

<style>
  .case-wrap { max-width: 880px; margin: 0 auto; padding: 64px 24px 96px; }

  .case-header { margin-bottom: 40px; }
  .case-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #666; margin-bottom: 24px;
  }
  .case-h1 {
    font-size: clamp(36px, 5vw, 60px); font-weight: 900; line-height: 1.05; letter-spacing: -1.5px;
    margin: 0 0 24px;
  }
  .case-lead { font-size: 20px; line-height: 1.5; color: #333; margin: 0; max-width: 720px; }

  .case-overview {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;
    border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;
    padding: 24px 0; margin: 48px 0;
  }
  @media (min-width: 640px) { .case-overview { grid-template-columns: repeat(4, 1fr); } }
  .overview-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #888; margin: 0 0 6px;
  }
  .overview-value { font-size: 16px; font-weight: 700; color: #1a1a1a; margin: 0; }

  .case-hero-image {
    aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #eaeaea;
    margin-bottom: 56px;
  }
  .case-image-inline { margin-bottom: 48px; }

  .case-duo {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    margin: 0 0 48px;
  }
  .case-duo .case-hero-image { margin-bottom: 0; }

  .case-section { margin-bottom: 48px; }
  .case-section h2 {
    font-size: clamp(28px, 3.5vw, 36px); font-weight: 900; letter-spacing: -0.5px;
    line-height: 1.1; margin: 0 0 20px;
  }
  .case-section h3 {
    font-size: 22px; font-weight: 800; letter-spacing: -0.3px; margin: 0 0 16px;
  }
  .case-section p {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 18px;
  }
  .case-section p strong {
    color: #1a1a1a; font-weight: 700;
  }

  /* Listas (bullets y numeradas) dentro de secciones */
  .case-section ul, .case-section ol {
    margin: 0 0 18px; padding-left: 22px;
  }
  .case-section li {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 10px;
  }
  .case-section li strong {
    color: #1a1a1a; font-weight: 700;
  }

  /* Tarjetas en cascada: Desafio -> Solucion -> Entregables */
  .case-flow { margin: 24px 0 8px; }
  .case-flow-card {
    border-radius: 14px; padding: 24px;
    background: #fafafa; border: 1px solid #e5e5e5; margin-bottom: 0;
  }
  .case-flow--desafio { border-left: 4px solid #1a1a1a; }
  .case-flow--solucion { border-left: 4px solid #FF4500; }
  .case-flow--resultado { border-left: 4px solid #E63E00; }
  .case-flow-label {
    display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: #666; margin-bottom: 10px;
  }
  .case-flow-card p { font-size: 16px; line-height: 1.6; color: #333; margin: 0; }
  .case-flow-card ul { margin: 0; padding-left: 18px; }
  .case-flow-card li { font-size: 15px; line-height: 1.6; color: #333; margin-bottom: 6px; }
  .case-flow-card li:last-child { margin-bottom: 0; }
  .case-flow-arrow {
    display: block; text-align: center; color: #999; font-size: 20px;
    line-height: 1; margin: 14px 0;
  }

  .case-cta-final {
    background: #1a1a1a; color: #fff; border-radius: 16px; padding: 48px;
    margin-top: 80px;
  }
  .case-cta-final h2 { color: #fff; margin: 0 0 16px; }
  .case-cta-final p { color: #ccc; }
  .case-cta { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .case-cta-btn {
    display: inline-flex; align-items: center; background: #FF4500; color: #fff;
    font-size: 15px; font-weight: 700; padding: 14px 24px; border-radius: 12px;
    text-decoration: none; transition: background 0.2s ease;
  }
  .case-cta-btn:hover { background: #e03d00; }
  .case-cta-link {
    color: #ccc; font-size: 14px; font-weight: 600; text-decoration: none;
    transition: color 0.2s ease;
  }
  .case-cta-link:hover { color: #fff; }
</style>
