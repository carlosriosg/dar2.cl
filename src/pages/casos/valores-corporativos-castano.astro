---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dar2.cl/' },
  { name: 'Casos', url: 'https://dar2.cl/casos/' },
  { name: 'Video de Valores · CASTAÑO', url: 'https://dar2.cl/casos/valores-corporativos-castano/' },
];

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Video de Valores Corporativos: Caso Castaño y Claves de Éxito",
  "description": "Descubre cómo transformar la cultura e historia de tu empresa en un video corporativo de alto impacto. Caso de éxito Castaño por DAR2.",
  "image": {
    "@type": "ImageObject",
    "url": "https://dar2.cl/images/portafolio/valores-castano.png",
    "width": 1200,
    "height": 675
  },
  "datePublished": "2023-09-01",
  "dateModified": "2026-08-25",
  "author": {
    "@type": "Person",
    "@id": "https://dar2.cl/#person",
    "name": "Carlos Rios Guevara"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://dar2.cl/#organization",
    "name": "DAR2 Servicios Audiovisuales",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dar2.cl/images/galeria/dar2_logo_firma.png",
      "width": 400,
      "height": 118
    }
  },
  "mainEntityOfPage": "https://dar2.cl/casos/valores-corporativos-castano/",
  "about": {
    "@type": "Organization",
    "name": "CASTAÑO",
    "url": "https://pedidos.castano.cl/nosotros",
    "foundingDate": "1933"
  },
  "inLanguage": "es-CL",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".case-header", ".case-section"]
  }
};
---

<Base
  title="Video de Valores Corporativos: Caso Castaño y Claves de Éxito"
  description="Descubre cómo transformar la cultura e historia de tu empresa en un video corporativo de alto impacto. Caso de éxito Castaño por DAR2."
  breadcrumbs={breadcrumbs}
  preloadImage="/images/portafolio/valores-castano.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseSchema)} />
  </Fragment>

  <article class="case-wrap">

    <!-- Hero -->
    <header class="case-header">
      <p class="case-eyebrow">Caso · Retail Alimenticio · 2023</p>
      <h1 class="case-h1">
        Video de Valores Corporativos:
        <em class="hl">Caso Castaño y claves de éxito.</em>
      </h1>
      <p class="case-lead">
        Un video de valores corporativos efectivo transforma conceptos abstractos como "compromiso" o "calidad" en activos visuales auténticos. Al documentar testimonios reales del equipo e hitos operativos, se fortalece la cultura organizacional y se optimizan los procesos de inducción en empresas corporativas.
      </p>
    </header>

    <!-- Overview -->
    <dl class="case-overview">
      <div>
        <dt class="overview-label">Cliente</dt>
        <dd class="overview-value">CASTAÑO</dd>
      </div>
      <div>
        <dt class="overview-label">Año</dt>
        <dd class="overview-value">2023</dd>
      </div>
      <div>
        <dt class="overview-label">Servicio</dt>
        <dd class="overview-value">Video corporativo</dd>
      </div>
      <div>
        <dt class="overview-label">Sector</dt>
        <dd class="overview-value">Retail Alimenticio</dd>
      </div>
    </dl>

    <!-- Imagen hero -->
    <div class="case-hero-image">
      <Picture
        src="/images/portafolio/valores-castano.png"
        alt="Valores Corporativos CASTAÑO — Producción audiovisual DAR2"
        class="w-full h-full object-cover"
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>

    <!-- La problemática -->
    <section class="case-section">
      <h2>La problemática de las presentaciones tradicionales en Recursos Humanos.</h2>
      <p>
        Transmitir la cultura organizacional y los pilares de marca a cientos o miles de colaboradores suele convertirse en un cuello de botella operacional para los directores de RR.HH. y gerentes de personas en Chile.
      </p>
      <ul>
        <li><strong>Pérdida de engagement:</strong> Las presentaciones extensas en diapositivas o los documentos extensos raras veces generan una conexión emocional real.</li>
        <li><strong>Uso ineficiente de horas hombre:</strong> Los equipos de inducción dedican decenas de horas semanales a repetir discursos corporativos de forma presencial.</li>
        <li><strong>Falta de consistencia:</strong> El mensaje institucional tiende a diluirse o distorsionarse a medida que la empresa escala y abre nuevas sucursales o plantas.</li>
      </ul>
    </section>

    <!-- Caso de éxito -->
    <section class="case-section">
      <h2>Caso de Éxito: Producción audiovisual para Castaño.</h2>
      <p>
        Con más de 90 años de historia en Chile y un equipo de más de 2.000 colaboradores, Castaño necesitaba un material institucional estratégico para sus procesos de comunicación interna, onboarding y capacitaciones sin caer en clichés ni discursos genéricos.
      </p>
      <div class="case-flow">
        <div class="case-flow-card case-flow--desafio">
          <span class="case-flow-label">Desafío organizacional</span>
          <p>Transmitir tradición e inocuidad en 2 plantas y +50 puntos internos.</p>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--solucion">
          <span class="case-flow-label">Solución audiovisual</span>
          <ul>
            <li>Cámaras Z CAM E2-S6 con óptica cinema y luz natural</li>
            <li>Testimoniales reales (panaderos, operarios, jefas de local)</li>
            <li>Rodaje bajo protocolos de inocuidad en planta activa</li>
          </ul>
        </div>
        <span class="case-flow-arrow">↓</span>
        <div class="case-flow-card case-flow--resultado">
          <span class="case-flow-label">Resultado e impacto</span>
          <ul>
            <li>Reducción del 30% en consultas recurrentes sobre valores</li>
            <li>Optimización directa de horas de capacitación presencial</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Claves técnicas -->
    <section class="case-section">
      <h2>Claves técnicas para un video de cultura organizacional efectivo.</h2>
      <p>
        Para lograr que una pieza audiovisual funcione como un activo de marca duradero en el ámbito B2B, es indispensable cuidar la estrategia de producción:
      </p>
      <ol>
        <li><strong>Testimonios sin guion rígido:</strong> Entrevistar al personal operativo en su entorno real aporta una autenticidad imposible de replicar con actores o locuciones impersonales.</li>
        <li><strong>Dirección de arte en locación real:</strong> Capturar los procesos productivos vivos —como el trabajo en planta y el servicio en local— entrega textura visual y credibilidad al espectador.</li>
        <li><strong>Estándar de calidad broadcast:</strong> La utilización de cámaras cinema (como la Z CAM E2-S6), iluminación profesional bien integrada y captura de audio limpia garantiza una pieza institucional duradera.</li>
        <li><strong>Entregables modulares:</strong> Además del video principal, es clave generar micro-cápsulas editadas por separado para su distribución en canales internos, redes o pantallas corporativas.</li>
      </ol>
    </section>

    <!-- Resultados -->
    <section class="case-section">
      <h2>Resultados medibles en la comunicación interna.</h2>
      <p>
        El impacto de una estrategia audiovisual bien ejecutada va más allá de lo estético; genera un retorno directo en la eficiencia operativa de la empresa:
      </p>
      <ul>
        <li><strong>Estandarización del onboarding:</strong> El mensaje de valores se transmite exactamente con la misma calidad e intencionalidad a cada nuevo contratado.</li>
        <li><strong>Ahorro de tiempo en inducción:</strong> Al automatizar el módulo de cultura en las capacitaciones, el área de Recursos Humanos libera tiempo estratégico.</li>
        <li><strong>Multiplicidad de usos:</strong> Un activo audiovisual sólido sirve para inducciones, reuniones anuales de líderes, presentaciones a proveedores y pantallas en instalaciones.</li>
      </ul>
    </section>

    <!-- CTA -->
    <section class="case-section case-cta-final">
      <h2>¿Quieres potenciar la cultura organizacional de tu empresa?</h2>
      <p>
        En DAR2 diseñamos y realizamos videos corporativos, de valores e institucionales adaptados a los desafíos reales de tu compañía en Santiago y todo Chile.
      </p>
      <div class="case-cta">
        <a href="/contacto/" class="case-cta-btn">
          Cotizar video corporativo →
        </a>
        <a href="/servicios/videos-corporativos/" class="case-cta-link">
          Conocer Videos Corporativos →
        </a>
        <a href="/casos/" class="case-cta-link">
          O ver más casos →
        </a>
      </div>
    </section>

  </article>
</Base>

<style>
  .case-wrap { max-width: 880px; margin: 0 auto; padding: 64px 24px 96px; }

  .case-header { margin-bottom: 40px; }
  .case-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #666; margin-bottom: 24px;
  }
  .case-h1 {
    font-size: clamp(36px, 5vw, 60px); font-weight: 900; line-height: 1.05; letter-spacing: -1.5px;
    margin: 0 0 24px;
  }
  .case-lead { font-size: 20px; line-height: 1.5; color: #333; margin: 0; max-width: 720px; }

  .case-overview {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;
    border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;
    padding: 24px 0; margin: 48px 0;
  }
  @media (min-width: 640px) { .case-overview { grid-template-columns: repeat(4, 1fr); } }
  .overview-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #888; margin: 0 0 6px;
  }
  .overview-value { font-size: 16px; font-weight: 700; color: #1a1a1a; margin: 0; }

  .case-hero-image {
    aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #eaeaea;
    margin-bottom: 56px;
  }

  .case-section { margin-bottom: 48px; }
  .case-section h2 {
    font-size: clamp(28px, 3.5vw, 36px); font-weight: 900; letter-spacing: -0.5px;
    line-height: 1.1; margin: 0 0 20px;
  }
  .case-section h3 {
    font-size: 22px; font-weight: 800; letter-spacing: -0.3px; margin: 0 0 16px;
  }
  .case-section p {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 18px;
  }
  .case-section p strong {
    color: #1a1a1a; font-weight: 700;
  }

  /* Listas (bullets y numeradas) dentro de secciones */
  .case-section ul, .case-section ol {
    margin: 0 0 18px; padding-left: 22px;
  }
  .case-section li {
    font-size: 17px; line-height: 1.7; color: #333; margin: 0 0 10px;
  }
  .case-section li strong {
    color: #1a1a1a; font-weight: 700;
  }

  /* Tarjetas en cascada: Desafio -> Solucion -> Resultado */
  .case-flow { margin: 24px 0 8px; }
  .case-flow-card {
    border-radius: 14px; padding: 24px;
    background: #fafafa; border: 1px solid #e5e5e5; margin-bottom: 0;
  }
  .case-flow--desafio { border-left: 4px solid #1a1a1a; }
  .case-flow--solucion { border-left: 4px solid #FF4500; }
  .case-flow--resultado { border-left: 4px solid #E63E00; }
  .case-flow-label {
    display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: #666; margin-bottom: 10px;
  }
  .case-flow-card p { font-size: 16px; line-height: 1.6; color: #333; margin: 0; }
  .case-flow-card ul { margin: 0; padding-left: 18px; }
  .case-flow-card li { font-size: 15px; line-height: 1.6; color: #333; margin-bottom: 6px; }
  .case-flow-card li:last-child { margin-bottom: 0; }
  .case-flow-arrow {
    display: block; text-align: center; color: #999; font-size: 20px;
    line-height: 1; margin: 14px 0;
  }

  .case-cta-final {
    background: #1a1a1a; color: #fff; border-radius: 16px; padding: 48px;
    margin-top: 80px;
  }
  .case-cta-final h2 { color: #fff; margin: 0 0 16px; }
  .case-cta-final p { color: #ccc; }
  .case-cta { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .case-cta-btn {
    display: inline-flex; align-items: center; background: #FF4500; color: #fff;
    font-size: 15px; font-weight: 700; padding: 14px 24px; border-radius: 12px;
    text-decoration: none; transition: background 0.2s ease;
  }
  .case-cta-btn:hover { background: #e03d00; }
  .case-cta-link {
    color: #ccc; font-size: 14px; font-weight: 600; text-decoration: none;
    transition: color 0.2s ease;
  }
  .case-cta-link:hover { color: #fff; }
</style>
