---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dar2.cl/' },
  { name: 'Casos', url: 'https://dar2.cl/casos/' },
];

const cases = [
  {
    slug: 'circuito-cerrado-la-mar',
    title: 'Circuito Cerrado Multicámara · La Mar Cebichería',
    excerpt: 'Cobertura multicámara en vivo para la cumbre culinaria de los 18 años de La Mar Cebichería: 7 cámaras, cámaras PTZ sobre cada estación y 5 pantallas verticales con detalle en tiempo real.',
    year: 2026,
    sector: 'Gastronomía',
    service: 'Circuito Cerrado (CCTV)',
    image: '/images/casos/circuito-cerrado-la-mar/ambiente-salones.jpg',
  },
  {
    slug: 'podcast-transelec-innovacion-china',
    title: 'Videopodcast · Transelec',
    excerpt: 'Cómo el equipo de Innovación de Transelec convirtió tres meses de inmersión tecnológica en China en un videopodcast Talk Show que conectó a más de 150 colaboradores en vivo.',
    year: 2026,
    sector: 'Energía',
    service: 'Video Podcast',
    image: '/images/podcast/set-general.jpg',
  },
  {
    slug: 'bomba-minera-vogt-pelambres',
    title: 'Sala de Bombas Tipo Contenedor · VOGT',
    excerpt: 'Producción audiovisual industrial: rodaje en faena minera para Vogt en Los Pelambres (+3.000 msnm) con acreditaciones HSEQ, cine compacto y entregables modulares para ferias B2B.',
    year: 2025,
    sector: 'Minería',
    service: 'Video corporativo',
    image: '/images/portafolio/vogt-bomba-pelambres.png',
  },
  {
    slug: 'valores-corporativos-castano',
    title: 'Valores Corporativos · CASTAÑO',
    excerpt: 'Video de valores para Castaño (90 años, 2.000+ colaboradores): testimonios reales del equipo, dirección de arte en planta y estándar broadcast para fortalecer la cultura y optimizar la inducción.',
    year: 2023,
    sector: 'Retail Alimenticio',
    service: 'Video corporativo',
    image: '/images/portafolio/valores-castano.png',
  },
  {
    slug: 'cirugia-robotica-clinica-santa-maria',
    title: 'Cirugía Robótica · Clínica Santa María',
    excerpt: 'Producción audiovisual en salud: rodaje en quirófano activo para Clínica Santa María (2.400+ intervenciones robóticas) con cine compacto, validación médica en sitio y entregables modulares.',
    year: 2022,
    sector: 'Salud',
    service: 'Video corporativo',
    image: '/images/portafolio/Armado-Hugo-RAS2.png',
  },
];
---

<Base
  title="Casos de éxito — Producción audiovisual en Chile"
  description="Casos detallados de producción audiovisual de DAR2: video corporativo, streaming y live shopping para empresas chilenas de salud, retail y energía."
  breadcrumbs={breadcrumbs}
>

  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-[#666] mb-6">Casos</p>
    <h1 class="text-5xl md:text-6xl font-black tracking-tight leading-[1.05] mb-6 max-w-3xl">
      Cómo trabajamos
      <em class="not-italic italic text-[#FF4500]"> con nuestros clientes.</em>
    </h1>
    <p class="text-lg text-[#666] max-w-2xl leading-relaxed">
      Selección de proyectos contados en detalle: el desafío, nuestra solución, ejecución y resultados.
    </p>
  </section>

  <!-- Enfoque de trabajo -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-6 bg-[#fafafa] border border-[#e5e5e5]">
        <p class="text-3xl font-black text-[#FF4500] mb-2">15+</p>
        <p class="text-xs font-bold uppercase tracking-widest text-[#888] mb-3">Años de experiencia</p>
        <p class="text-sm text-[#555] leading-relaxed">
          Desde 2010 produciendo contenido audiovisual corporativo para empresas chilenas e internacionales. Más de 200 proyectos entregados.
        </p>
      </div>
      <div class="p-6 bg-[#fafafa] border border-[#e5e5e5]">
        <p class="text-3xl font-black text-[#FF4500] mb-2">9</p>
        <p class="text-xs font-bold uppercase tracking-widest text-[#888] mb-3">Servicios integrados</p>
        <p class="text-sm text-[#555] leading-relaxed">
          Streaming, live shopping, multicámara para eventos, estudio virtual, videos corporativos, video podcast, estrategias digitales, redes sociales y filtros AR. Un solo proveedor, una sola factura.
        </p>
      </div>
      <div class="p-6 bg-[#fafafa] border border-[#e5e5e5]">
        <p class="text-3xl font-black text-[#FF4500] mb-2">40+</p>
        <p class="text-xs font-bold uppercase tracking-widest text-[#888] mb-3">Marcas cliente</p>
        <p class="text-sm text-[#555] leading-relaxed">
          Hemos trabajado con empresas del IPSA, retail, salud, minería, banca y sector público. Clientes como Cencosud, ENAP, Clínica Santa María, AFP Habitat, PC Factory y más.
        </p>
      </div>
    </div>
    <div class="mt-8 max-w-3xl">
      <p class="text-base text-[#555] leading-relaxed">
        Cada caso que compartimos refleja cómo abordamos los desafíos de nuestros clientes: desde la conceptualización y preproducción hasta la ejecución técnica y postproducción. Todos los proyectos son reales, con empresas reales, y los resultados hablan por sí solos. Si tienes un proyecto en mente, el primer paso es una conversación sin compromiso para entender tu objetivo, tu audiencia y tu presupuesto.
      </p>
    </div>
  </section>

  <!-- Listado con thumbnails -->
  <section class="max-w-5xl mx-auto px-6 pb-24 border-t border-[#e5e5e5] pt-12">
    <ul class="cases-list">
      {cases.map(c => (
        <li class="case-item">
          <a href={`/casos/${c.slug}/`} class="case-link">
            <div class="case-thumb">
              <Picture
                src={c.image}
                alt={c.title}
                width="730"
                height="411"
                class="case-thumb-img"
                loading="lazy"
              />
            </div>
            <div class="case-body">
              <p class="case-meta">{c.sector} · {c.year} · {c.service}</p>
              <h2 class="case-title">{c.title}</h2>
              <p class="case-excerpt">{c.excerpt}</p>
              <p class="case-readmore">Ver caso →</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

</Base>

<style>
  .cases-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .case-item {
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 40px;
  }
  .case-item:last-child {
    border-bottom: none;
  }

  .case-link {
    text-decoration: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    color: inherit;
  }
  @media (min-width: 768px) {
    .case-link {
      grid-template-columns: 360px 1fr;
      gap: 32px;
      align-items: center;
    }
  }

  .case-thumb {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #eaeaea;
  }
  .case-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .case-link:hover .case-thumb :global(img) {
    transform: scale(1.04);
  }

  .case-body {
    display: flex;
    flex-direction: column;
  }

  .case-meta {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #666;
    margin: 0 0 10px;
  }

  .case-title {
    font-size: 24px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.4px;
    margin: 0 0 10px;
    color: #1a1a1a;
    transition: color 0.2s ease;
  }
  @media (min-width: 768px) {
    .case-title { font-size: 26px; }
  }

  .case-link:hover .case-title {
    color: #E63E00;
  }

  .case-excerpt {
    font-size: 15px;
    line-height: 1.55;
    color: #555;
    margin: 0 0 12px;
  }

  .case-readmore {
    font-size: 14px;
    font-weight: 700;
    color: #E63E00;
    margin: 0;
  }
</style>
