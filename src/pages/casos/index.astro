---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { casosPorAnio } from '../../data/casos.js';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dar2.cl/' },
  { name: 'Casos', url: 'https://dar2.cl/casos/' },
];

const cases = casosPorAnio;
---

<Base
  title="Casos de éxito — Producción audiovisual en Chile"
  description="Casos detallados de producción audiovisual de DAR2: video corporativo, streaming y live shopping para empresas chilenas de salud, retail y energía."
  breadcrumbs={breadcrumbs}
>

  <!-- Hero + cifras compactas -->
  <section class="max-w-7xl mx-auto px-6 pt-14 md:pt-20 pb-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-[#666] mb-5">Casos</p>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05] mb-5 max-w-3xl">
      Cómo trabajamos
      <em class="not-italic text-[#FF4500]"> con nuestros clientes.</em>
    </h1>
    <p class="text-lg text-[#666] max-w-2xl leading-relaxed">
      Selección de proyectos contados en detalle: el desafío, nuestra solución, ejecución y resultados.
    </p>

    <div class="mt-10 flex flex-wrap gap-x-12 gap-y-6 border-t border-[#e5e5e5] pt-8">
      <div>
        <p class="text-4xl font-black text-[#FF4500]">15+</p>
        <p class="text-xs font-bold uppercase tracking-widest text-[#888] mt-1">Años de experiencia</p>
      </div>
      <div>
        <p class="text-4xl font-black text-[#FF4500]">9</p>
        <p class="text-xs font-bold uppercase tracking-widest text-[#888] mt-1">Servicios integrados</p>
      </div>
      <div>
        <p class="text-4xl font-black text-[#FF4500]">40+</p>
        <p class="text-xs font-bold uppercase tracking-widest text-[#888] mt-1">Marcas cliente</p>
      </div>
    </div>
  </section>

  <!-- Listado con thumbnails -->
  <section class="max-w-5xl mx-auto px-6 pb-24 border-t border-[#e5e5e5] pt-12">
    <ul class="cases-list">
      {cases.map(c => (
        <li class="case-item">
          <a href={`/casos/${c.slug}/`} class="case-link">
            <div class="case-thumb">
              <Picture
                src={c.image.replace(/\.(png|jpe?g)$/i, '-card.$1')}
                alt={c.title}
                width="730"
                height="411"
                class="case-thumb-img"
                loading="lazy"
                responsive
                sizes="(max-width: 640px) 95vw, 360px"
              />
            </div>
            <div class="case-body">
              <p class="case-meta">{c.sector} · {c.year} · {c.service}</p>
              <h2 class="case-title">{c.title}</h2>
              <p class="case-excerpt">{c.excerpt}</p>
              <p class="case-readmore">Ver caso →</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

</Base>

<style>
  .cases-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .case-item {
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 40px;
  }
  .case-item:last-child {
    border-bottom: none;
  }

  .case-link {
    text-decoration: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    color: inherit;
  }
  @media (min-width: 768px) {
    .case-link {
      grid-template-columns: 360px 1fr;
      gap: 32px;
      align-items: center;
    }
  }

  .case-thumb {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #eaeaea;
  }
  .case-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .case-link:hover .case-thumb :global(img) {
    transform: scale(1.04);
  }

  .case-body {
    display: flex;
    flex-direction: column;
  }

  .case-meta {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #666;
    margin: 0 0 10px;
  }

  .case-title {
    font-size: 24px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.4px;
    margin: 0 0 10px;
    color: #1a1a1a;
    transition: color 0.2s ease;
  }
  @media (min-width: 768px) {
    .case-title { font-size: 26px; }
  }

  .case-link:hover .case-title {
    color: #E63E00;
  }

  .case-excerpt {
    font-size: 15px;
    line-height: 1.55;
    color: #555;
    margin: 0 0 12px;
  }

  .case-readmore {
    font-size: 14px;
    font-weight: 700;
    color: #E63E00;
    margin: 0;
  }
</style>
