---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { articulos } from '../../data/blog.js';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://dar2.cl/' },
  { name: 'Blog', url: 'https://dar2.cl/blog/' },
];

// La lista vive en src/data/blog.js: la comparten el índice y el bloque
// "Sigue leyendo" de cada artículo. Al agregar un post, editar ese archivo.
const articles = articulos;

// Schema Blog + ItemList para que Google muestre rich results de carousel
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://dar2.cl/blog/#blog",
  "url": "https://dar2.cl/blog/",
  "name": "Blog DAR2 — Guías de producción audiovisual y digital",
  "description": "Artículos y guías sobre producción audiovisual, live shopping, streaming corporativo, video marketing y tendencias para empresas en Chile.",
  "inLanguage": "es-CL",
  "publisher": { "@id": "https://dar2.cl/#organization" },
  "blogPost": articles.map((a) => ({
    "@type": "BlogPosting",
    "headline": a.title,
    "url": `https://dar2.cl/blog/${a.slug}/`,
    "datePublished": a.date,
    "dateModified": a.date,
    "description": a.excerpt,
    "image": `https://dar2.cl${a.image}`,
    "author": { "@id": "https://dar2.cl/#person" },
    "publisher": { "@id": "https://dar2.cl/#organization" }
  }))
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Artículos del Blog DAR2",
  "itemListElement": articles.map((a, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `https://dar2.cl/blog/${a.slug}/`,
    "name": a.title
  }))
};
---

<Base
  title="Blog de Producción Audiovisual para Empresas"
  description="Blog y guías de producción audiovisual B2B en Chile: streaming corporativo, live shopping, video empresarial, estudio virtual y filtros AR."
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-14 md:pt-20 pb-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-[#666] mb-5">Blog</p>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05] mb-4 max-w-3xl">
      Guías de producción
      <em class="text-accent italic"> audiovisual y digital.</em>
    </h1>
    <p class="text-lg text-[#666] max-w-2xl leading-relaxed">
      Artículos sobre live shopping, streaming corporativo, video marketing y tendencias para empresas en Chile.
    </p>
  </section>

  <!-- Listado -->
  <section class="max-w-5xl mx-auto px-6 pb-24 border-t border-border pt-12">
    <ul class="blog-list">
      {articles.map(art => (
        <li class="blog-item">
          <a href={`/blog/${art.slug}/`} class="blog-link">
            <div class="blog-thumb">
              <Picture
                src={art.image.replace(/\.(png|jpe?g)$/i, '-card.$1')}
                alt={art.title}
                width="730"
                height="411"
                class="blog-thumb-img"
                loading="lazy"
                responsive
                sizes="(max-width: 640px) 95vw, 360px"
              />
            </div>
            <div class="blog-body">
              <p class="blog-meta">{art.category} · {art.readTime} de lectura</p>
              <h2 class="blog-title">{art.title}</h2>
              <p class="blog-excerpt">{art.excerpt}</p>
              <p class="blog-readmore">Leer artículo →</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Navegacion a servicios -->
  <section class="max-w-5xl mx-auto px-6 pb-24 border-t border-border pt-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-[#666] mb-4">Servicios</p>
    <h2 class="text-3xl font-black tracking-tight mb-6">¿Necesitas producción audiovisual?</h2>
    <p class="text-[#666] max-w-2xl leading-relaxed mb-10">
      Los artículos del blog son guías educativas. Si necesitas producción audiovisual profesional para tu empresa, conoce nuestros servicios.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/servicios/streaming/" class="block p-5 border border-[#e5e5e5] rounded-xl hover:border-[#1a1a1a] transition-colors">
        <p class="font-bold text-sm mb-1">Streaming</p>
        <p class="text-xs text-[#666]">Transmisión en vivo corporativa</p>
      </a>
      <a href="/servicios/live-shopping/" class="block p-5 border border-[#e5e5e5] rounded-xl hover:border-[#1a1a1a] transition-colors">
        <p class="font-bold text-sm mb-1">Live Shopping</p>
        <p class="text-xs text-[#666]">Ventas en vivo integradas a e-commerce</p>
      </a>
      <a href="/servicios/videos-corporativos/" class="block p-5 border border-[#e5e5e5] rounded-xl hover:border-[#1a1a1a] transition-colors">
        <p class="font-bold text-sm mb-1">Videos Corporativos</p>
        <p class="text-xs text-[#666]">Producción institucional con cámara cinema</p>
      </a>
      <a href="/servicios/estudio-virtual/" class="block p-5 border border-[#e5e5e5] rounded-xl hover:border-[#1a1a1a] transition-colors">
        <p class="font-bold text-sm mb-1">Estudio Virtual</p>
        <p class="text-xs text-[#666]">Escenografías virtuales con chroma key</p>
      </a>
    </div>
  </section>

</Base>

<style>
  .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .blog-item {
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 40px;
  }
  .blog-item:last-child {
    border-bottom: none;
  }

  .blog-link {
    text-decoration: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    color: inherit;
  }
  @media (min-width: 768px) {
    .blog-link {
      grid-template-columns: 360px 1fr;
      gap: 32px;
      align-items: center;
    }
  }

  .blog-thumb {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #eaeaea;
    transition: transform 0.3s ease;
  }
  .blog-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-link:hover .blog-thumb :global(img) {
    transform: scale(1.04);
  }

  .blog-body {
    display: flex;
    flex-direction: column;
  }

  .blog-meta {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #666;
    margin: 0 0 10px;
  }

  .blog-title {
    font-size: 24px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.4px;
    margin: 0 0 10px;
    color: #1a1a1a;
    transition: color 0.2s ease;
  }
  @media (min-width: 768px) {
    .blog-title { font-size: 26px; }
  }

  .blog-link:hover .blog-title {
    color: #E63E00;
  }

  .blog-excerpt {
    font-size: 15px;
    line-height: 1.55;
    color: #555;
    margin: 0 0 12px;
  }

  .blog-readmore {
    font-size: 14px;
    font-weight: 700;
    color: #E63E00;
    margin: 0;
  }
</style>
