---
const { delay = 0, y = '24px', duration = 600, once = true, stagger = 0 } = Astro.props;
const uid = `r-${crypto.randomUUID()}`;
---

<div class="reveal" id={uid} data-duration={duration} data-delay={delay} data-y={y} data-once={once} data-stagger={stagger}>
  <slot />
</div>

<style>
  .reveal {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.is-animated {
    opacity: 0;
    transform: translateY(24px);
  }

  .reveal.is-animated.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const el = document.getElementById('{uid}');
  if (el) {
    const duration = Number(el.dataset.duration) || 600;
    const delay = Number(el.dataset.delay) || 0;
    const y = el.dataset.y || '24px';
    const once = el.dataset.once !== 'false';
    const stagger = Number(el.dataset.stagger) || 0;

    el.style.transition = `opacity ${duration}ms ease, transform ${duration}ms ease`;
    el.style.transitionDelay = `${delay}ms`;

    el.classList.add('is-animated');
    el.style.transform = `translateY(${y})`;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (stagger > 0) {
            const children = el.children;
            Array.from(children).forEach((child, i) => {
              const childEl = child as HTMLElement;
              childEl.style.opacity = '0';
              childEl.style.transform = 'translateY(20px)';
              childEl.style.transition = `opacity ${duration}ms ease, transform ${duration}ms ease`;
              childEl.style.transitionDelay = `${delay + stagger * i}ms`;
              requestAnimationFrame(() => {
                childEl.style.opacity = '1';
                childEl.style.transform = 'translateY(0)';
              });
            });
          } else {
            el.classList.add('is-visible');
          }
          if (once) observer.unobserve(el);
        } else if (!once) {
          el.classList.remove('is-visible');
        }
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    observer.observe(el);
  }
</script>
